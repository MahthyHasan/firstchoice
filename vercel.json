{
  "version": 2,
  "builds": [
    {
      "src": "server/src/lambda.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/src/mail/templates/**", "server/dist/mail/templates/**"]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/src/lambda.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
